<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>
<%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %>
<spring:htmlEscape defaultHtmlEscape="true"/>
<!doctype html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:choose><c:when test="${not empty layout}"><sitemesh:write property="title" /></c:when><c:otherwise><c:out value="${pageTitle}"/></c:otherwise></c:choose> · LTWeb BT5</title>
    <link rel="stylesheet" href="<c:url value='/css/app.css'/>">
</head>
<body data-layout="<c:out value='${layout}'/>">
<a class="skip-link" href="#main">Đến nội dung</a>
<header class="site-header">
    <nav class="shell nav" aria-label="Điều hướng chính">
        <a class="brand" href="<c:url value='/'/>">LTWeb <span>BT5</span></a>
        <div class="nav-links">
            <c:if test="${pageContext.request.isUserInRole('ADMIN')}">
                <a href="<c:url value='/admin/categories'/>">Danh mục</a>
                <a href="<c:url value='/admin/users'/>">Người dùng</a>
            </c:if>
            <c:choose>
                <c:when test="${empty pageContext.request.userPrincipal}">
                    <a href="<c:url value='/login'/>">Đăng nhập</a>
                    <a href="<c:url value='/register'/>">Đăng ký</a>
                </c:when>
                <c:otherwise>
                    <form method="post" action="<c:url value='/logout'/>">
                        <%@ include file="csrf.jspf" %>
                        <button class="quiet" type="submit">Đăng xuất</button>
                    </form>
                </c:otherwise>
            </c:choose>
        </div>
    </nav>
</header>
<main class="shell" id="main" tabindex="-1">
    <c:if test="${not empty notice}"><p class="notice" role="status"><c:out value="${notice}"/></p></c:if>
    <c:if test="${not empty problem}"><p class="error" role="alert"><c:out value="${problem}"/></p></c:if>
